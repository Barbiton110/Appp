# כתובת ציבורית של השרת (חובה HTTPS בפרודקשן). אינסטגרם מוריד את התמונות מכאן,
# ולכן היא חייבת להיות נגישה מהאינטרנט. בפיתוח מקומי: השתמשו ב-ngrok / cloudflared.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# מפתח הצפנה לטוקנים של אינסטגרם במסד הנתונים (מחרוזת אקראית ארוכה)
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-long-random-string

# ---- Meta / Instagram (Business Login for Instagram) ----
# App Dashboard > Instagram > API setup with Instagram business login
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v26.0
# מצב בדיקה: 1 = לא מפרסם באמת לאינסטגרם, רק מדמה הצלחה (נוח לפיתוח)
IG_DRY_RUN=1

# ---- AI (אופציונלי) ----
# כיתובים (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# יצירת תמונות (OpenAI Images API)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# תיקיית נתונים (מסד נתונים + תמונות)
DATA_DIR=./data
